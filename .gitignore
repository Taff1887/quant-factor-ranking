# --- Secrets ---
.env
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- uv ---
# uv.lock IS committed for reproducibility (do not ignore it)

# --- Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Testing / typing / linting caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data lake (reproducible from the pipeline; never commit raw vendor data) ---
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# --- OS ---
.DS_Store
Thumbs.db
